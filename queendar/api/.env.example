# Queendar API (owner-auth.py) — copy to /opt/queendar/.env on Hostman
PORT=3019
QUEENDAR_PUBLIC_URL=https://queendar.com

# Owner bootstrap (first admin account)
OWNER_USER=dannygc
OWNER_PASS=
OWNER_EMAIL=

# Optional AI (cloudit-gpu)
AI_CODER_URL=http://127.0.0.1:18001/v1
AI_CODER_MODEL=nemotron-3.5-lightning:latest
AI_VL_URL=http://127.0.0.1:18000/v1
AI_VL_MODEL=Qwen3-VL-30B-A3B-Instruct-FP8
AI_TIMEOUT_SEC=90

# Optional Stripe / Twilio
# STRIPE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# QUEENDAR_TWILIO_FROM=

# Auto-generated on first run if missing:
# QUEENDAR_TOKEN_SECRET=
# QUEENDAR_JOURNAL_KEY=
