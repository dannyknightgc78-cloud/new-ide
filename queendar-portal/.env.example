# Copy: cp .env.example .env   Validate: bash scripts/validate-env.sh
PORT=3011
PUBLIC_URL=https://queendar.com
DATA_DIR=/data

# Owner sign-in (separate from STICKY). Hash is stored in /data/owner.json.
OWNER_USER=dannygc
OWNER_PASS=

# Admin API (performer create / seed) — required for seed-demo.sh
ADMIN_API_KEY=

# Shared secret for Queen → Hostman ops tunnel heal (ops-agent /api/ops/tunnel/*)
QUEEN_OPS_TOKEN=

# Ops-agent on Hostman host (from container)
OPS_AGENT_URL=http://host.docker.internal:8788

# cloudit-gpu (2× RTX PRO 6000) via Hostman SSH tunnel — coder :18001 (NOT Trooper)
AI_BASE_URL=http://host.docker.internal:18001/v1
AI_MODEL=nemotron-3.5-lightning:latest
AI_TIMEOUT_MS=120000
# Optional VL: http://host.docker.internal:18000/v1  model Qwen3-VL-30B-A3B-Instruct-FP8

# Booking inquiries → Telegram DM (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe tip links — paste performer Connect URLs in profile for now
# STRIPE_PUBLISHABLE_KEY=
